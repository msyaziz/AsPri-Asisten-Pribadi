NODE_ENV=production
PORT=3000
HOST=127.0.0.1
TZ=Asia/Jakarta
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgres://asisten:GANTI_PASSWORD@127.0.0.1:5432/asisten

# WhatsApp (format JID penuh). Isi setelah mode pairing.
WHITELIST_JID=
WHITELIST_LID=
PAIRING_MODE=true
BOT_PHONE_NUMBER=

# Groq (aktifkan Zero Data Retention di console Groq > Data Controls)
GROQ_API_KEY=
GROQ_TEXT_MODEL=
GROQ_VISION_MODEL=
GROQ_RPM_LIMIT=20

# Penyimpanan data (auth_info, receipts, backups)
DATA_DIR=./data
